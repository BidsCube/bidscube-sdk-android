<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bidscube</groupId>
    <artifactId>bidscube-sdk-bom</artifactId>
    <version>1.2.3</version>
    <packaging>pom</packaging>

    <name>Bidscube SDK BOM</name>
    <description>
        Bill of Materials for the Bidscube Android stack. The library artifact is com.bidscube:bidscube-sdk (AAR),
        built from the Gradle :sdk module; import this BOM when you want aligned dependency versions via Maven or Gradle platform().
        Host applications should enable core library desugaring when using IMA / Media3 (see AndroidX release notes).
        This POM is not deployed from CI; align versions with the SDK release you consume (JitPack, local AAR, or your internal Maven).
    </description>
    <url>https://github.com/BidsCube/bidscube-sdk</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/BidsCube/bidscube-sdk/blob/main/LICENSE</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>BidsCube Team</name>
            <email>dev@bidscube.com</email>
            <organization>BidsCube</organization>
            <organizationUrl>https://bidscube.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/BidsCube/bidscube-sdk.git</connection>
        <developerConnection>scm:git:ssh://github.com/BidsCube/bidscube-sdk.git</developerConnection>
        <url>https://github.com/BidsCube/bidscube-sdk</url>
    </scm>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <bidscube-sdk.version>1.2.3</bidscube-sdk.version>
        <ump.version>2.2.0</ump.version>
        <play-services-ads-identifier.version>18.0.1</play-services-ads-identifier.version>
        <interactivemedia.version>3.37.0</interactivemedia.version>
        <media3.version>1.4.1</media3.version>
        <material.version>1.12.0</material.version>
        <glide.version>4.15.1</glide.version>
        <desugar_jdk_libs.version>2.0.4</desugar_jdk_libs.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bidscube</groupId>
                <artifactId>bidscube-sdk</artifactId>
                <version>${bidscube-sdk.version}</version>
                <type>aar</type>
            </dependency>

            <dependency>
                <groupId>com.google.android.ump</groupId>
                <artifactId>user-messaging-platform</artifactId>
                <version>${ump.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.android.gms</groupId>
                <artifactId>play-services-ads-identifier</artifactId>
                <version>${play-services-ads-identifier.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.ads.interactivemedia.v3</groupId>
                <artifactId>interactivemedia</artifactId>
                <version>${interactivemedia.version}</version>
            </dependency>

            <dependency>
                <groupId>androidx.media3</groupId>
                <artifactId>media3-common</artifactId>
                <version>${media3.version}</version>
            </dependency>

            <dependency>
                <groupId>androidx.media3</groupId>
                <artifactId>media3-ui</artifactId>
                <version>${media3.version}</version>
            </dependency>

            <dependency>
                <groupId>androidx.cardview</groupId>
                <artifactId>cardview</artifactId>
                <version>1.0.0</version>
            </dependency>

            <dependency>
                <groupId>com.google.android.material</groupId>
                <artifactId>material</artifactId>
                <version>${material.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.bumptech.glide</groupId>
                <artifactId>glide</artifactId>
                <version>${glide.version}</version>
            </dependency>

            <dependency>
                <groupId>com.android.tools</groupId>
                <artifactId>desugar_jdk_libs</artifactId>
                <version>${desugar_jdk_libs.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
