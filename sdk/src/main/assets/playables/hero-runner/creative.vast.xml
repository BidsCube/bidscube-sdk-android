<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bidscube gamified interstitial — full creative package (triple-page).

  Flow: intro video → HTML playable (playables/hero-runner/index.html) → static end card.

  Trafficking:
  - Replace intro MP4 URL with advertiser asset
  - Host playables/hero-runner/ on HTTPS CDN and set playableUrl
  - Replace companion StaticResource with store screenshot
-->
<VAST version="3.0">
  <Ad id="bidscube-gamified-hero-runner">
    <InLine>
      <AdSystem version="1.0">Bidscube</AdSystem>
      <AdTitle><![CDATA[Hero Runner — try before you install]]></AdTitle>
      <Impression><![CDATA[https://example.com/impression/gamified]]></Impression>
      <Creatives>
        <!-- Phase 1: intro video -->
        <Creative id="intro-video" sequence="1">
          <Linear skipoffset="00:00:05">
            <Duration>00:00:15</Duration>
            <VideoClicks>
              <ClickThrough><![CDATA[https://www.google.com]]></ClickThrough>
            </VideoClicks>
            <MediaFiles>
              <MediaFile delivery="progressive" type="video/mp4" width="1280" height="720" bitrate="800">
                <![CDATA[https://storage.googleapis.com/interactive-media-ads/media/big_buck_bunny.mp4]]>
              </MediaFile>
            </MediaFiles>
            <Extensions>
              <Extension type="bidscubePlayable">
                <BidscubePlayable
                  playableUrl="playables/hero-runner/index.html"
                  goalCollectibles="5"
                  maxSeconds="20"
                  skipAfterSeconds="5"
                  heroEmoji="🎮"
                  hint="Drag the hero • collect stars"/>
              </Extension>
            </Extensions>
          </Linear>
        </Creative>
        <!-- Phase 3: end card (phase 2 playable is HTML from playableUrl above) -->
        <Creative id="end-card" sequence="2">
          <CompanionAds>
            <Companion width="1280" height="720" assetWidth="1280" assetHeight="720">
              <StaticResource creativeType="image/jpeg">
                <![CDATA[https://www.gstatic.com/webp/gallery/3.jpg]]>
              </StaticResource>
              <CompanionClickThrough><![CDATA[https://www.google.com]]></CompanionClickThrough>
            </Companion>
          </CompanionAds>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
